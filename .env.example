# Copy to .env (never commit .env)
OWL_PORT=4317
# Where the SQLite database lives (relative paths are relative to the process working directory)
OWL_DATA_DIR=./data
# Runs executing at once (a session never runs two at the same time)
OWL_CONCURRENCY=1
# Folders projects and runs may work in, ":"-separated. Default: your home folder (hidden folders such as ~/.ssh are always refused)
# OWL_WORKSPACE_ROOTS=/path/to/projects:/another/root
# Extra browser origins allowed to call the API, comma-separated (the Vite dev server needs none: it proxies /api)
# OWL_ALLOWED_ORIGINS=http://localhost:5173
# Optional backup (see docs/guide/configuration.md). Both are public/non-secret settings; keys and logins stay in age/rclone's own config
# OWL_BACKUP_AGE_RECIPIENT=age1...
# OWL_BACKUP_RCLONE_REMOTE=myremote:owl
# Optional local models
# OLLAMA_URL=http://127.0.0.1:11434
